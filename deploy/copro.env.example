# Copié automatiquement vers /etc/copro.env par install.sh (lisible seulement par root et l'utilisateur copro).
# Ne jamais mettre ce fichier dans un dépôt Git.

# Clé secrète des sessions : générer avec  python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=a-remplacer

# Adresse publique du site (sert à construire les liens de connexion envoyés par email)
BASE_URL=https://4ruedemoscou.fr

# Base de données SQLite
DB_PATH=/srv/copro/data/copro.db

# Stockage des documents : s3 (recommandé) ou local
STORAGE=s3
S3_BUCKET=copro-4moscou-documents
AWS_REGION=eu-north-1

# Emails de connexion via Amazon SES
MAIL=ses
MAIL_FROM="Copropriété 4 rue de Moscou <ne-pas-repondre@4ruedemoscou.fr>"

# En production : NE PAS afficher le lien de connexion à l'écran
DEV_SHOW_LINK=0

# Identifiants de l'utilisateur IAM "copro-app" (droits limités, voir iam-policy.json)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
